{
  "name": "capture-spec-sessions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Exports every Warp, Claude Code, or Hermes conversation of one spec across specify/implement/review as raw JSONL for a later learning phase.",
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:schema": "tsx scripts/gen-schema-lookup.ts"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "protobufjs": "8.8.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
